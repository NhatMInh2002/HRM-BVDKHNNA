# Nginx — không commit private key / cert
nginx/certs/

# Java / Maven
**/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# Frontend build info
frontend/tsconfig.tsbuildinfo

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local
frontend/coverage/

# IDE
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# Secrets — NEVER commit
.env
.env.local
.env.production
application-secret.yml
application-prod.yml
*.p12
*.jks
*.pem

# Logs
*.log
logs/
frontend/.env.local
backend_logs.txt

# Data scripts / dumps chứa dữ liệu nhạy cảm (mật khẩu, PII) — không commit
scripts/data/

# Báo cáo đánh giá bảo mật — KHÔNG commit (chứa chi tiết lỗ hổng/khai thác).
# Lưu cục bộ và gửi trực tiếp cho người phụ trách; chỉ giữ README giải thích chính sách.
docs/security/*
!docs/security/README.md
