# Copy file này thành .env:  cp .env.example .env
# File .env KHÔNG được commit lên git.
#
# ⚠️ Backend khi chạy hot-reload ( mvnw spring-boot:run ) KHÔNG đọc .env — nó dùng
#    giá trị mặc định trong backend/app/src/main/resources/application.yml.
#    Các giá trị dưới đây ĐÃ được đặt KHỚP với default đó, nên chạy dev là được ngay.
#    ➜ Ở PRODUCTION bắt buộc đổi thành chuỗi mạnh (và export cho backend — xem
#      docs/guides/developer-guide.md mục 5).

# --- Dev defaults (khớp application.yml — đừng đổi nếu chỉ chạy local) ---
POSTGRES_PASSWORD=hrm_dev_pass
MINIO_ROOT_PASSWORD=hrm_minio_pass
JWT_SECRET=hrm-bvnghean-secret-key-2025-must-be-at-least-32-chars
NEXTAUTH_SECRET=doi-thanh-chuoi-random-cho-nextauth

# Ký số VGCA đơn nghỉ phép — để false cho đến khi đăng ký xong dịch vụ với
# Ban Cơ yếu Chính phủ. Có thể bật true ở dev để thử luồng bằng
# scripts/fake-vgca-sign.sh (an toàn — không gọi ra dịch vụ VGCA thật).
VGCA_ENABLED=false
