# Copy file này thành .env và điền giá trị thật
# File .env KHÔNG được commit lên git

POSTGRES_PASSWORD=your_strong_password_here
JWT_SECRET=your_random_secret_min_32_chars_here
NEXTAUTH_SECRET=your_nextauth_secret_here
MINIO_ROOT_PASSWORD=your_minio_password_here

# Ký số VGCA đơn nghỉ phép — để false cho đến khi đăng ký xong dịch vụ với
# Ban Cơ yếu Chính phủ. Bật true ở môi trường dev/test để thử luồng bằng
# scripts/fake-vgca-sign.sh (an toàn — không gọi ra dịch vụ VGCA thật).
VGCA_ENABLED=true
