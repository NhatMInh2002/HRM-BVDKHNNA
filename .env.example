# Copy file này thành .env và điền giá trị thật
# KHÔNG commit file .env lên git

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/hrm
DB_USERNAME=hrm
DB_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/hrm
KEYCLOAK_ADMIN_PASSWORD=change_me

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me

# Next.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_32chars_minimum
KEYCLOAK_CLIENT_ID=hrm-frontend
KEYCLOAK_CLIENT_SECRET=change_me
